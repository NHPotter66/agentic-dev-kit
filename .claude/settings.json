{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  }
}
